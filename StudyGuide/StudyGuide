//Setter Code Sample 
package getterAndSetter;

public class MyWorker {
    
    private double length;
    private double width;
    private double area;
    
    // Setter for length
    public void setLength(double length) {
        this.length = length;
    }
    
    // Setter for width
    public void setWidth(double width) {
        this.width = width;
    }
    
    // Getter for area
    public double getArea() {
        return area;
    }
    
    // Method to calculate area
    public void calArea() {
        area = length * width;
    }
}
